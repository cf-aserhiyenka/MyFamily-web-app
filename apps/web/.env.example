# Copy this file to .env.local and fill in the values.

DATABASE_URL="postgresql://admin:password123@localhost:5433/family_db"

# Generate a random secret, e.g.: npx auth secret
# or: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-string"

# MinIO (local S3-compatible storage, used for the media gallery)
# User/password match docker-compose.yml (service "minio").
# You need to create the bucket manually in the MinIO console
# the first time you run the app — see README.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="myfamily_admin"
S3_SECRET_KEY="myfamily_dev_password"
S3_BUCKET_NAME="myfamily-media"

# Sending emails (email address verification)
# Free test key from https://resend.com. Without a verified domain,
# Resend only lets you send emails to the address you signed up with
# that's enough for local development.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Base URL of the app — used to build the verification link in the email.
APP_URL="http://localhost:3000"
