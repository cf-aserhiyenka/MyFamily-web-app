generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdFamilies Family[]
  familyMembers   FamilyMember[]
  personNode      PersonNode?

  createdPersonNodes      PersonNode[]             @relation("PersonNodeCreatedBy")
  createdPersonRelations  PersonRelation[]         @relation("PersonRelationCreatedBy")
  emailVerificationTokens EmailVerificationToken[]
}

model Family {
  id                  String    @id @default(uuid())
  name                String
  description         String?
  avatarBase64        String?
  isActive            Boolean   @default(true)
  deletionRequestedAt DateTime?
  createdAt           DateTime  @default(now())

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  members       FamilyMember[]
  invitations   FamilyInvitation[]
  conversations Conversation[]
  budgets       Budget[]
  expenses      Expense[]
  savingGoals   SavingGoal[]
  albums        Album[]
  mediaFiles    MediaFile[]

  treeMemberships FamilyTreeMembership[]
  personRelations PersonRelation[]
}

model FamilyMember {
  id       String       @id @default(uuid())
  role     FamilyRole
  status   MemberStatus @default(PENDING)
  joinedAt DateTime     @default(now())

  user     User   @relation(fields: [userId], references: [id])
  userId   String
  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  personNode   PersonNode @relation(fields: [personNodeId], references: [id])
  personNodeId String

  sentInvitations          FamilyInvitation[]
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                  @relation("MessageSender")
  createdConversations     Conversation[]             @relation("ConversationCreatedBy")
  createdBudgets           Budget[]                   @relation("BudgetCreatedBy")
  paidExpenses             Expense[]                  @relation("ExpensePaidBy")
  createdSavingGoals       SavingGoal[]               @relation("SavingGoalCreatedBy")
  goalContributions        GoalContribution[]         @relation("GoalContributionMember")
  createdAlbums            Album[]                    @relation("AlbumCreatedBy")
  uploadedMediaFiles       MediaFile[]                @relation("MediaFileUploadedBy")

  addedTreeMemberships FamilyTreeMembership[]

  @@unique([userId, familyId])
}

enum FamilyRole {
  PARENT
  CHILD
  GUARDIAN
  SENIOR
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
}

model PersonNode {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  maidenName   String?
  birthDate    DateTime?
  birthPlace   String?
  deathDate    DateTime?
  deathPlace   String?
  occupation   String?
  bio          String?
  avatarBase64 String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  createdBy   User   @relation("PersonNodeCreatedBy", fields: [createdById], references: [id])
  createdById String

  familyMembers FamilyMember[]
  memberships   FamilyTreeMembership[]
  relationsAsA  PersonRelation[]       @relation("RelationA")
  relationsAsB  PersonRelation[]       @relation("RelationB")
}

enum RelationType {
  PARENT_OF
  PARTNER_OF
  SIBLING_OF
}

model FamilyTreeMembership {
  id      String   @id @default(uuid())
  addedAt DateTime @default(now())

  person   PersonNode @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId String

  addedBy   FamilyMember @relation(fields: [addedById], references: [id])
  addedById String

  @@unique([personId, familyId])
}

model PersonRelation {
  id        String       @id @default(uuid())
  relation  RelationType
  createdAt DateTime     @default(now())

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyId String

  personA   PersonNode @relation("RelationA", fields: [personAId], references: [id], onDelete: Cascade)
  personAId String

  personB   PersonNode @relation("RelationB", fields: [personBId], references: [id], onDelete: Cascade)
  personBId String

  createdBy   User   @relation("PersonRelationCreatedBy", fields: [createdById], references: [id])
  createdById String

  @@unique([familyId, personAId, personBId, relation])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model FamilyInvitation {
  id         String     @id @default(uuid())
  token      String     @unique
  email      String
  role       FamilyRole
  expiresAt  DateTime
  usedAt     DateTime?
  declinedAt DateTime?
  createdAt  DateTime   @default(now())

  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  invitedBy   FamilyMember @relation(fields: [invitedById], references: [id])
  invitedById String
}


enum ConversationType {
  GROUP_DEFAULT
  GROUP_CUSTOM
  DIRECT
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType
  name          String?
  createdAt     DateTime         @default(now())
  lastMessageAt DateTime?

  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  createdBy   FamilyMember? @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdById String?

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id       String    @id @default(uuid())
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String

  member   FamilyMember @relation(fields: [memberId], references: [id])
  memberId String

  @@unique([conversationId, memberId])
}

model Message {
  id        String    @id @default(uuid())
  content   String
  sentAt    DateTime  @default(now())
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String

  sender   FamilyMember @relation("MessageSender", fields: [senderId], references: [id])
  senderId String
}

enum BudgetCategory {
  GROCERIES
  BILLS
  EDUCATION
  HEALTH
  ENTERTAINMENT
  TRANSPORT
  OTHER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id          String         @id @default(uuid())
  name        String
  category    BudgetCategory
  limitAmount Decimal        @db.Decimal(12, 2)
  period      BudgetPeriod
  currency    String         @default("PLN")
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  createdBy   FamilyMember @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  createdById String

  expenses Expense[]
}

model Expense {
  id        String   @id @default(uuid())
  title     String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  budget   Budget? @relation(fields: [budgetId], references: [id])
  budgetId String?

  paidBy   FamilyMember @relation("ExpensePaidBy", fields: [paidById], references: [id])
  paidById String
}

model SavingGoal {
  id           String    @id @default(uuid())
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  deadline     DateTime?
  currency     String    @default("PLN")
  isAchieved   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  createdBy   FamilyMember @relation("SavingGoalCreatedBy", fields: [createdById], references: [id])
  createdById String

  contributions GoalContribution[]
}

model GoalContribution {
  id            String   @id @default(uuid())
  amount        Decimal  @db.Decimal(12, 2)
  note          String?
  contributedAt DateTime @default(now())

  goal   SavingGoal @relation(fields: [goalId], references: [id])
  goalId String

  member   FamilyMember @relation("GoalContributionMember", fields: [memberId], references: [id])
  memberId String
}

enum AlbumType {
  DEFAULT
  CUSTOM
}

enum MediaType {
  IMAGE
}

model Album {
  id          String    @id @default(uuid())
  name        String
  description String?
  type        AlbumType
  createdAt   DateTime  @default(now())

  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  createdBy   FamilyMember? @relation("AlbumCreatedBy", fields: [createdById], references: [id])
  createdById String?

  coverFile   MediaFile? @relation("AlbumCover", fields: [coverFileId], references: [id])
  coverFileId String?    @unique

  files MediaFile[] @relation("AlbumFiles")
}

model MediaFile {
  id           String    @id @default(uuid())
  storageKey   String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  type         MediaType
  width        Int?
  height       Int?
  takenAt      DateTime?
  uploadedAt   DateTime  @default(now())

  family   Family @relation(fields: [familyId], references: [id])
  familyId String

  album   Album  @relation("AlbumFiles", fields: [albumId], references: [id])
  albumId String

  uploadedBy   FamilyMember @relation("MediaFileUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String

  coverOfAlbum Album? @relation("AlbumCover")
}